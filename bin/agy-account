#!/bin/bash
# agy-account — switch Antigravity CLI (agy) account by swapping its keyring token.
#
# agy stores its OAuth token in the macOS login keychain at service=gemini,
# account=antigravity. A "profile" is a snapshot of that blob, kept in the same
# keychain under service=gemini-profile. Switching = copying a profile's blob
# back into the live entry; agy reads the token at startup, so a fresh `agy`
# session picks up the new account immediately.
#
# Usage:
#   agy-account save <name>   snapshot the CURRENT login as profile <name>
#   agy-account use <name>    switch the live login to profile <name>
#   agy-account list          list saved profiles
#   agy-account whoami        show the email agy last authenticated as
#   agy-account logout        delete the live token (next `agy` run opens browser login)
set -euo pipefail

SVC=gemini ACCT=antigravity PSVC=gemini-profile

live_blob() { security find-generic-password -s "$SVC" -a "$ACCT" -w 2>/dev/null; }

case "${1:-}" in
  save)
    [ -n "${2:-}" ] || { echo "usage: agy-account save <name>"; exit 1; }
    blob=$(live_blob) || { echo "no live agy login found (service=$SVC account=$ACCT)"; exit 1; }
    security add-generic-password -U -s "$PSVC" -a "$2" -w "$blob"
    echo "saved current login as profile '$2'"
    ;;
  use)
    [ -n "${2:-}" ] || { echo "usage: agy-account use <name>"; exit 1; }
    blob=$(security find-generic-password -s "$PSVC" -a "$2" -w 2>/dev/null) \
      || { echo "no profile '$2' — run: agy-account save $2 (while logged into that account)"; exit 1; }
    # snapshot whatever is live right now so a not-yet-saved login is never lost
    cur=$(live_blob) && security add-generic-password -U -s "$PSVC" -a "_last" -w "$cur" || true
    security delete-generic-password -s "$SVC" -a "$ACCT" >/dev/null 2>&1 || true
    security add-generic-password -s "$SVC" -a "$ACCT" -w "$blob"
    echo "switched to profile '$2' — restart any running agy session (token is read at startup)"
    ;;
  list)
    security dump-keychain 2>/dev/null \
      | grep -B12 "\"svce\"<blob>=\"$PSVC\"" \
      | sed -n 's/.*"acct"<blob>="\(.*\)".*/\1/p' | sort -u \
      | sed 's/^_last$/_last (auto-backup of the login replaced by the last "use")/'
    ;;
  whoami)
    # agy logs the authenticated email at startup; read it from the newest CLI log
    # (sed -n 1p, not head -1: head would SIGPIPE ls under pipefail with many logs)
    # shellcheck disable=SC2012  # log names are cli-<timestamp>.log — safe to sort with ls
    log=$(ls -t "$HOME/.gemini/antigravity-cli/log"/cli-*.log 2>/dev/null | sed -n 1p)
    { [ -n "$log" ] && grep -ao 'email=[^,]*' "$log" | sed -n '$p' | cut -d= -f2; } \
      || echo "no auth line in newest agy log — run agy once and retry"
    ;;
  logout)
    security delete-generic-password -s "$SVC" -a "$ACCT" >/dev/null
    echo "live token removed — next agy run will ask you to log in via browser"
    ;;
  *)
    awk 'NR>1 { if (/^#/) { sub(/^# ?/,""); print } else exit }' "$0"
    exit 1
    ;;
esac
